# Database Configuration for Vibe Coder Portfolio
# For local XAMPP development, standard defaults (127.0.0.1:3306, user 'root', empty password) are used automatically.
# For Render deployment, set these environment variables in your Render Web Service dashboard.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vibe_coder_portfolio
DB_USER=root
DB_PASS=

# Optional: Path to CA certificate for remote MySQL SSL/TLS connections (e.g., /etc/ssl/certs/ca-certificates.crt)
DB_SSL_CA=
